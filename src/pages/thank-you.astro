---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout
  title={`Request Received | ${siteConfig.name}`}
  description="Your Blue Horizon Pools quote request has been received."
>
  <main class="thanks-page">
    <section class="thanks-card" aria-labelledby="thanks-title">
      <div class="check" aria-hidden="true">✓</div>
      <p class="eyebrow">Request received</p>
      <h1 id="thanks-title">Thanks — your pool closing request is in.</h1>
      <p>
        Blue Horizon Pools will review the information you submitted and contact you about the next step.
      </p>
      <div class="actions">
        <a class="primary" href="/">Back to home</a>
        <a class="secondary" href={siteConfig.phoneHref}>Call {siteConfig.phoneDisplay}</a>
      </div>
      <p class="urgent-note">
        Need to speak with someone directly? Use the phone link above. This page does not promise a specific response time.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .thanks-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
    background:
      radial-gradient(circle at 80% 15%, rgba(27, 166, 200, 0.14), transparent 28%),
      linear-gradient(180deg, #f7fbff, #edf8fc);
  }

  .thanks-card {
    width: min(680px, 100%);
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 1.8rem;
    background: white;
    box-shadow: 0 28px 70px rgba(24, 67, 86, 0.12);
    text-align: center;
  }

  .check {
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #dff5ea;
    color: #287a4d;
    font-size: 1.8rem;
    font-weight: 900;
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .thanks-card > p:not(.eyebrow):not(.urgent-note) {
    color: var(--color-muted);
    font-size: 1.08rem;
  }

  .actions {
    margin-top: 1.6rem;
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .actions a {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    font-weight: 850;
    text-decoration: none;
  }

  .primary {
    background: var(--color-primary);
    color: white;
  }

  .secondary {
    color: var(--color-primary-strong);
  }

  .urgent-note {
    margin: 1.5rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.8rem;
  }
</style>
