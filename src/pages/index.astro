---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { benefits, closingOverview, faqs, processSteps, siteConfig } from '../config/site';

const pricingLabel = siteConfig.pricing.showPublicPricing
  ? `Starting at $${siteConfig.pricing.startingAt.toFixed(2)}`
  : 'Package confirmed after review';
---

<BaseLayout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription}>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="#top" aria-label="Blue Horizon Pools home">
        <span class="brand-mark" aria-hidden="true">BH</span>
        <span><strong>Blue Horizon</strong><small>Pools</small></span>
      </a>
      <div class="header-actions">
        <a class="phone-link" href={siteConfig.phoneHref}>Call {siteConfig.phoneDisplay}</a>
        <a class="button button-small" href="#quote">Get a Quote</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero section">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">{siteConfig.campaign.eyebrow}</p>
          <h1>{siteConfig.campaign.headline}</h1>
          <p class="hero-subtitle">{siteConfig.campaign.subheadline}</p>
          <div class="hero-actions">
            <a class="button" href="#quote">{siteConfig.campaign.primaryCta}</a>
            <a class="button button-secondary" href={siteConfig.phoneHref}>{siteConfig.campaign.secondaryCta}</a>
          </div>
          <p class="hero-note"><span aria-hidden="true"></span> Fall appointments are limited by available service capacity.</p>
        </div>

        <div class="hero-visual" aria-label="Stylized backyard pool illustration">
          <div class="sun"></div>
          <div class="land"></div>
          <div class="pool"><div class="water"></div></div>
          <div class="visual-card"><b>✓</b><span><strong>Photo-based review</strong><small>Pool + cover + equipment</small></span></div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Why use the quote process">
      <div class="container trust-grid">
        {benefits.map((item) => (
          <article><span aria-hidden="true">✓</span><div><h2>{item.title}</h2><p>{item.body}</p></div></article>
        ))}
      </div>
    </section>

    <section class="section white-section">
      <div class="container two-grid">
        <div>
          <p class="eyebrow">A simpler way to get started</p>
          <h2>We review the setup before confirming the closing package.</h2>
          <p class="lead">You do not need to know which Blue Horizon package your pool falls under. Send the details and photos and the setup can be reviewed first.</p>
        </div>
        <div class="info-card">
          <p class="card-label">What the quote review considers</p>
          <ul>{closingOverview.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
          <p class="fine-print">Final service scope is confirmed directly with Blue Horizon Pools before an appointment is arranged.</p>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">How it works</p>
          <h2>From quote request to pool closing in four clear steps.</h2>
        </div>
        <div class="process-grid">
          {processSteps.map((step) => (
            <article class="process-card"><span>{step.number}</span><h3>{step.title}</h3><p>{step.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section white-section">
      <div class="container two-grid pricing-grid">
        <div>
          <p class="eyebrow">Pool closing packages</p>
          <h2>Pricing depends on the pool and cover configuration.</h2>
          <p class="lead">Blue Horizon Pools uses multiple closing package levels. You do not have to guess which one applies.</p>
          <a class="text-link" href="#quote">Send my pool details →</a>
        </div>
        <div class="pricing-card">
          <span>Pool closing</span>
          <strong>{pricingLabel}</strong>
          <p>Package fit is based on the information and photos you provide. Final pricing is confirmed directly before service is arranged.</p>
          <a class="button button-light" href="#quote">Request My Quote</a>
        </div>
      </div>
    </section>

    <section class="section area-section">
      <div class="container area-card">
        <div><p class="eyebrow">Service area</p><h2>{siteConfig.serviceArea.heading}</h2><p>{siteConfig.serviceArea.summary}</p></div>
        <div class="area-badge" aria-hidden="true"><strong>GTA</strong><span>+ surrounding communities</span></div>
      </div>
    </section>

    <section id="quote" class="section quote-section" aria-labelledby="quote-heading">
      <div class="container quote-layout">
        <div class="quote-copy">
          <p class="eyebrow light">Pool closing quote</p>
          <h2 id="quote-heading">Tell us about your pool.</h2>
          <p>The form takes a few minutes. Photos of the pool, cover, and equipment area help Blue Horizon Pools review the setup before contacting you.</p>
          <div class="quote-points">
            <span>✓ Mobile-friendly photo upload</span>
            <span>✓ No need to know your package code</span>
            <span>✓ Contact details stay attached to your request</span>
          </div>
        </div>
        <QuoteForm />
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-grid">
        <div><p class="eyebrow">Common questions</p><h2>Pool closing, without the guesswork.</h2><p class="lead">Quick answers before you send your request.</p></div>
        <div class="faq-list">
          {faqs.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="final-section">
      <div class="container final-card">
        <div><p class="eyebrow light">Ready when you are</p><h2>Get your pool closing request started.</h2><p>Send your pool details online, or call Blue Horizon Pools directly.</p></div>
        <div class="final-actions"><a class="button button-light" href="#quote">Get My Pool Closing Quote</a><a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a></div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-wrap">
      <div><strong>Blue Horizon Pools</strong><p>Pool closing and seasonal pool service.</p></div>
      <div><a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a><a href="/privacy">Privacy</a></div>
    </div>
  </footer>
</BaseLayout>

<style>
  .site-header{position:sticky;top:0;z-index:30;border-bottom:1px solid rgba(216,228,236,.8);background:rgba(247,251,255,.94);backdrop-filter:blur(14px)}
  .nav-wrap,.header-actions,.hero-actions,.final-actions,.footer-wrap{display:flex;align-items:center}.nav-wrap{min-height:4.75rem;justify-content:space-between;gap:1rem}.header-actions,.hero-actions,.final-actions{gap:.75rem}
  .brand{display:flex;align-items:center;gap:.7rem;text-decoration:none}.brand-mark{width:2.5rem;height:2.5rem;display:grid;place-items:center;border-radius:50%;background:linear-gradient(145deg,#0d6e9e,#1ba6c8);color:#fff;font-size:.78rem;font-weight:900}.brand strong,.brand small{display:block;line-height:1.05}.brand small{margin-top:.15rem;color:var(--color-muted);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase}.phone-link{font-weight:850;text-decoration:none}
  .section{padding:5.5rem 0}.white-section{background:#fff}.eyebrow{margin:0 0 .85rem;color:var(--color-primary);font-size:.78rem;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.light{color:#bdeaf4}.lead,.hero-subtitle{color:var(--color-muted);font-size:clamp(1.05rem,2vw,1.22rem)}
  h1,h2,h3,p{margin-top:0}h1{max-width:11ch;margin-bottom:1.3rem;font-size:clamp(3.1rem,7vw,6rem);line-height:.95;letter-spacing:-.055em}h2{margin-bottom:1.15rem;font-size:clamp(2rem,4vw,3.6rem);line-height:1.02;letter-spacing:-.04em}h3{margin-bottom:.5rem}
  .button{min-height:3rem;display:inline-flex;align-items:center;justify-content:center;padding:.82rem 1.2rem;border:1px solid var(--color-primary);border-radius:999px;background:var(--color-primary);color:#fff;font-weight:850;text-decoration:none;box-shadow:0 10px 24px rgba(13,110,158,.18)}.button:hover,.button:focus-visible{background:var(--color-primary-strong)}.button-secondary{background:transparent;color:var(--color-primary-strong);box-shadow:none}.button-small{min-height:2.65rem;padding:.65rem 1rem;font-size:.9rem}.button-light{border-color:#fff;background:#fff;color:var(--color-primary-strong)}
  .hero{overflow:hidden;padding-top:4.5rem;background:radial-gradient(circle at 78% 18%,rgba(27,166,200,.12),transparent 28%),linear-gradient(180deg,#f7fbff,#eef8fc)}.hero-grid,.two-grid,.quote-layout,.faq-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:clamp(2.5rem,7vw,6rem)}.hero-subtitle{max-width:42rem;margin-bottom:1.75rem}.hero-note{display:flex;align-items:center;gap:.55rem;margin-top:1.4rem;color:var(--color-muted);font-size:.9rem}.hero-note span{width:.58rem;height:.58rem;border-radius:50%;background:#45a66b;box-shadow:0 0 0 5px rgba(69,166,107,.12)}
  .hero-visual{position:relative;min-height:31rem;overflow:hidden;border-radius:2rem;background:linear-gradient(180deg,#bce8f5 0 52%,#d7e8ca 52%);box-shadow:0 30px 70px rgba(24,67,86,.16)}.sun{position:absolute;top:3rem;right:4rem;width:4rem;height:4rem;border-radius:50%;background:#ffe7a3}.land{position:absolute;inset:auto 0 0;height:13rem;background:linear-gradient(160deg,#aad39f,#d9e8ca)}.pool{position:absolute;left:10%;right:10%;bottom:4rem;height:13rem;padding:1rem;border-radius:45% 45% 36% 36%/34% 34% 54% 54%;background:#f8f2df;transform:perspective(700px) rotateX(58deg)}.water{height:100%;border-radius:inherit;background:linear-gradient(150deg,#2eb7d9,#0f86b6 65%,#136b9b)}.visual-card{position:absolute;right:1.2rem;bottom:1.2rem;display:flex;align-items:center;gap:.7rem;padding:.95rem 1rem;border-radius:1rem;background:rgba(255,255,255,.92);box-shadow:0 15px 30px rgba(23,54,67,.14)}.visual-card b{width:2rem;height:2rem;display:grid;place-items:center;border-radius:50%;background:#dff5ea;color:#287a4d}.visual-card strong,.visual-card small{display:block}.visual-card small{color:var(--color-muted)}
  .trust-strip{padding:2.2rem 0;border-block:1px solid var(--color-border);background:#fff}.trust-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.2rem}.trust-grid article{display:flex;gap:.7rem}.trust-grid article>span{flex:0 0 auto;width:1.7rem;height:1.7rem;display:grid;place-items:center;border-radius:50%;background:#e2f5fb;color:var(--color-primary-strong);font-weight:900}.trust-grid h2{margin-bottom:.2rem;font-size:1rem;letter-spacing:-.02em}.trust-grid p{margin:0;color:var(--color-muted);font-size:.88rem;line-height:1.45}
  .info-card,.pricing-card{padding:clamp(1.5rem,4vw,2.4rem);border:1px solid var(--color-border);border-radius:1.5rem;background:#f9fcfe;box-shadow:var(--shadow-sm)}.card-label{color:var(--color-muted);font-size:.78rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.info-card ul{display:grid;gap:1rem;margin:0;padding:0;list-style:none}.info-card li{display:grid;grid-template-columns:auto 1fr;gap:.7rem;font-weight:750}.info-card li span{color:#2e8a56}.fine-print{margin:1.4rem 0 0;padding-top:1.2rem;border-top:1px solid var(--color-border);color:var(--color-muted);font-size:.88rem}
  .process-section{background:#eef8fc}.section-heading{max-width:48rem;margin:0 auto 2.4rem;text-align:center}.process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.process-card{min-height:15rem;padding:1.5rem;border:1px solid #cfe2ea;border-radius:1.3rem;background:#fff}.process-card>span{display:block;margin-bottom:2.5rem;color:var(--color-primary);font-size:.78rem;font-weight:900;letter-spacing:.13em}.process-card p{color:var(--color-muted)}
  .pricing-card{border:0;background:linear-gradient(160deg,#0e6b98,#0b5a80);color:#fff}.pricing-card>span{color:#c8ebf5;font-size:.78rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.pricing-card>strong{display:block;margin:.7rem 0;font-size:clamp(2rem,4vw,3rem);line-height:1}.pricing-card p{color:#c8ebf5}.text-link{color:var(--color-primary-strong);font-weight:850;text-decoration:none}
  .area-section{padding-top:0;background:#fff}.area-card{display:grid;grid-template-columns:1.3fr .7fr;align-items:center;gap:2rem;padding:clamp(1.5rem,5vw,3rem);border:1px solid #d7eadc;border-radius:1.5rem;background:#f0f8f3}.area-card p{color:var(--color-muted)}.area-badge{justify-self:end;width:min(14rem,100%);aspect-ratio:1;display:grid;place-content:center;text-align:center;border-radius:50%;background:#fff;box-shadow:var(--shadow-sm)}.area-badge strong{color:var(--color-primary-strong);font-size:3rem}.area-badge span{max-width:9rem;color:var(--color-muted);font-size:.8rem}
  .quote-section{background:#0a5678;color:#fff}.quote-layout{align-items:start;grid-template-columns:.85fr 1.15fr}.quote-copy{position:sticky;top:7rem}.quote-copy>p:not(.eyebrow){color:#cde8f1;font-size:1.05rem}.quote-points{display:grid;gap:.65rem;margin-top:1.5rem;color:#e6f5f9;font-size:.9rem;font-weight:700}.faq-section{background:#f8fbfd}.faq-grid{align-items:start}.faq-list{border-top:1px solid var(--color-border)}details{border-bottom:1px solid var(--color-border)}summary{cursor:pointer;padding:1.2rem 2rem 1.2rem 0;font-weight:850;list-style:none;position:relative}summary::-webkit-details-marker{display:none}summary::after{content:'+';position:absolute;right:0;color:var(--color-primary);font-size:1.4rem}details[open] summary::after{content:'−'}details p{color:var(--color-muted)}
  .final-section{padding:0 0 5.5rem;background:#f8fbfd}.final-card{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:clamp(1.6rem,5vw,3.2rem);border-radius:1.6rem;background:linear-gradient(135deg,#0b628b,#0f8aab);color:#fff}.final-card h2{max-width:15ch}.final-card p:not(.eyebrow){margin-bottom:0;color:#d1edf4}.final-actions{flex-direction:column;align-items:stretch}.final-actions>a:last-child{color:#fff;font-weight:850;text-align:center;text-decoration:none}
  .site-footer{padding:2rem 0 3rem;background:#0b1f2b;color:#fff}.footer-wrap{justify-content:space-between;align-items:end;gap:1.5rem}.site-footer p{margin:.2rem 0 0;color:#a9c1cc}.footer-wrap>div:last-child{display:flex;gap:1rem}.site-footer a{color:#d7edf4;font-weight:700;text-decoration:none}
  @media(max-width:900px){.hero-grid,.two-grid,.quote-layout,.faq-grid,.area-card{grid-template-columns:1fr}.trust-grid,.process-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.quote-copy{position:static}.area-badge{justify-self:start;width:11rem}.final-card{align-items:flex-start;flex-direction:column}}
  @media(max-width:640px){.section{padding:4rem 0}.phone-link{display:none}.hero{padding-top:3rem}.hero-actions{align-items:stretch;flex-direction:column}.hero-actions .button{width:100%}.hero-visual{min-height:22rem;border-radius:1.5rem}.pool{bottom:3.5rem;height:10rem}.visual-card{left:1rem;right:1rem;bottom:1rem}.trust-grid,.process-grid{grid-template-columns:1fr}.process-card{min-height:0}.process-card>span{margin-bottom:1.5rem}.final-actions,.final-actions .button{width:100%}.footer-wrap{align-items:flex-start;flex-direction:column}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
