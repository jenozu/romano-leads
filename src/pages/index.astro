---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  benefits,
  closingOverview,
  faqs,
  processSteps,
  siteConfig,
} from '../config/site';

const pricingLabel = siteConfig.pricing.showPublicPricing
  ? `Starting at $${siteConfig.pricing.startingAt.toFixed(2)}`
  : 'Package confirmed after review';
---

<BaseLayout title={siteConfig.defaultTitle} description={siteConfig.defaultDescription}>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="#top" aria-label="Blue Horizon Pools home">
        <span class="brand-mark" aria-hidden="true">BH</span>
        <span>
          <strong>Blue Horizon</strong>
          <small>Pools</small>
        </span>
      </a>
      <div class="header-actions">
        <a class="phone-link" href={siteConfig.phoneHref}>
          <span class="phone-label">Call</span>
          <span>{siteConfig.phoneDisplay}</span>
        </a>
        <a class="button button-small" href="#quote">Get a Quote</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero section">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{siteConfig.campaign.eyebrow}</p>
          <h1>{siteConfig.campaign.headline}</h1>
          <p class="hero-subtitle">{siteConfig.campaign.subheadline}</p>

          <div class="hero-actions">
            <a class="button" href="#quote">{siteConfig.campaign.primaryCta}</a>
            <a class="button button-secondary" href={siteConfig.phoneHref}>
              {siteConfig.campaign.secondaryCta}
            </a>
          </div>

          <div class="hero-note" role="note">
            <span class="status-dot" aria-hidden="true"></span>
            <span>Fall appointments are limited by available service capacity.</span>
          </div>
        </div>

        <div class="hero-visual" aria-label="Stylized illustration of a backyard pool prepared for seasonal closing">
          <div class="sun"></div>
          <div class="tree tree-one"></div>
          <div class="tree tree-two"></div>
          <div class="pool-shell">
            <div class="pool-water">
              <span></span><span></span><span></span>
            </div>
          </div>
          <div class="visual-card">
            <span class="visual-card-icon" aria-hidden="true">✓</span>
            <span>
              <strong>Photo-based review</strong>
              <small>Send pool + cover photos</small>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Why homeowners use the quote process">
      <div class="container trust-grid">
        {benefits.map((item) => (
          <article class="trust-item">
            <div class="trust-icon" aria-hidden="true">✓</div>
            <div>
              <h2>{item.title}</h2>
              <p>{item.body}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section scope-section">
      <div class="container split-grid">
        <div>
          <p class="eyebrow">A simpler way to get started</p>
          <h2>We review the setup before confirming the closing package.</h2>
          <p class="section-lead">
            You do not need to know which Blue Horizon package your pool falls under. Share the basic details and a few photos, and the setup can be reviewed before pricing is confirmed.
          </p>
        </div>

        <div class="scope-card">
          <p class="scope-label">What the quote review considers</p>
          <ul>
            {closingOverview.map((item) => (
              <li>
                <span aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="scope-note">
            Final service scope is confirmed directly with Blue Horizon Pools before the appointment is arranged.
          </p>
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading centered">
          <p class="eyebrow">How it works</p>
          <h2>From quote request to pool closing in four clear steps.</h2>
        </div>

        <div class="process-grid">
          {processSteps.map((step) => (
            <article class="process-card">
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section pricing-section">
      <div class="container pricing-grid">
        <div>
          <p class="eyebrow">Pool closing packages</p>
          <h2>Pricing depends on the pool and cover configuration.</h2>
          <p class="section-lead">
            Blue Horizon Pools uses multiple closing package levels. Instead of asking you to guess which package applies, the quote request collects the details needed for review.
          </p>
          <a class="text-link" href="#quote">Send my pool details <span aria-hidden="true">→</span></a>
        </div>

        <div class="pricing-card">
          <span class="pricing-kicker">Pool closing</span>
          <strong>{pricingLabel}</strong>
          <p>
            Package fit is based on the information and photos you provide. Final pricing is confirmed directly before service is arranged.
          </p>
          <a class="button button-full" href="#quote">Request My Quote</a>
        </div>
      </div>
    </section>

    <section class="section area-section">
      <div class="container area-card">
        <div>
          <p class="eyebrow">Service area</p>
          <h2>{siteConfig.serviceArea.heading}</h2>
          <p>{siteConfig.serviceArea.summary}</p>
        </div>
        <div class="area-badge" aria-hidden="true">
          <span>GTA</span>
          <small>+ surrounding communities</small>
        </div>
      </div>
    </section>

    <section id="quote" class="section quote-section" aria-labelledby="quote-heading">
      <div class="container quote-shell">
        <div class="quote-copy">
          <p class="eyebrow eyebrow-light">Pool closing quote</p>
          <h2 id="quote-heading">Tell us about your pool.</h2>
          <p>
            The full quote form with photo upload is added in Build 3. For now, you can call Blue Horizon Pools directly.
          </p>
          <a class="button button-light" href={siteConfig.phoneHref}>Call {siteConfig.phoneDisplay}</a>
        </div>

        <div class="quote-preview" aria-label="Preview of the upcoming pool quote form">
          <div class="preview-row">
            <span>1</span>
            <div>
              <strong>Contact details</strong>
              <small>Name, phone, email, city</small>
            </div>
          </div>
          <div class="preview-row">
            <span>2</span>
            <div>
              <strong>Pool details</strong>
              <small>Pool type, cover, timing</small>
            </div>
          </div>
          <div class="preview-row">
            <span>3</span>
            <div>
              <strong>Pool photos</strong>
              <small>Pool, cover, equipment area</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-layout">
        <div class="faq-heading">
          <p class="eyebrow">Common questions</p>
          <h2>Pool closing, without the guesswork.</h2>
          <p>Quick answers before you send your quote request.</p>
        </div>

        <div class="faq-list">
          {faqs.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta section">
      <div class="container final-card">
        <div>
          <p class="eyebrow eyebrow-light">Ready when you are</p>
          <h2>Get your pool closing request started.</h2>
          <p>Send your pool details online, or call Blue Horizon Pools directly.</p>
        </div>
        <div class="final-actions">
          <a class="button button-light" href="#quote">Get My Pool Closing Quote</a>
          <a class="final-phone" href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-wrap">
      <div>
        <strong>Blue Horizon Pools</strong>
        <p>Pool closing and seasonal pool service.</p>
      </div>
      <div class="footer-actions">
        <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a>
        <a href="#quote">Request a quote</a>
      </div>
    </div>
  </footer>
</BaseLayout>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(216, 228, 236, 0.8);
    background: rgba(247, 251, 255, 0.93);
    backdrop-filter: blur(14px);
  }

  .nav-wrap {
    min-height: 4.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-mark {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #0d6e9e, #1ba6c8);
    color: white;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    box-shadow: 0 8px 20px rgba(13, 110, 158, 0.22);
  }

  .brand strong,
  .brand small {
    display: block;
    line-height: 1.05;
  }

  .brand strong {
    font-size: 0.97rem;
  }

  .brand small {
    margin-top: 0.15rem;
    color: var(--color-muted);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header-actions,
  .hero-actions,
  .final-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .phone-link {
    font-weight: 800;
    text-decoration: none;
    color: var(--color-text);
  }

  .phone-label {
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 0.3rem;
  }

  .section {
    padding: 5.5rem 0;
  }

  .hero {
    overflow: hidden;
    padding-top: 4.5rem;
    background:
      radial-gradient(circle at 78% 18%, rgba(27, 166, 200, 0.12), transparent 28%),
      linear-gradient(180deg, #f7fbff 0%, #eef8fc 100%);
  }

  .hero-grid,
  .split-grid,
  .pricing-grid,
  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    margin: 0 0 0.85rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow-light {
    color: #bdeaf4;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 11ch;
    margin-bottom: 1.3rem;
    font-size: clamp(3.2rem, 7vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  h2 {
    margin-bottom: 1.2rem;
    font-size: clamp(2rem, 4vw, 3.7rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  h3 {
    margin-bottom: 0.55rem;
    font-size: 1.15rem;
  }

  .hero-subtitle,
  .section-lead {
    max-width: 42rem;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .hero-subtitle {
    margin-bottom: 1.75rem;
  }

  .button {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.82rem 1.2rem;
    border: 1px solid var(--color-primary);
    border-radius: 999px;
    background: var(--color-primary);
    color: white;
    font-weight: 850;
    text-decoration: none;
    box-shadow: 0 10px 24px rgba(13, 110, 158, 0.18);
    transition: transform 150ms ease, background 150ms ease, box-shadow 150ms ease;
  }

  .button:hover,
  .button:focus-visible {
    transform: translateY(-1px);
    background: var(--color-primary-strong);
    box-shadow: 0 14px 28px rgba(13, 110, 158, 0.22);
  }

  .button-secondary {
    background: transparent;
    color: var(--color-primary-strong);
    box-shadow: none;
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    color: white;
  }

  .button-small {
    min-height: 2.65rem;
    padding: 0.65rem 1rem;
    font-size: 0.9rem;
  }

  .button-light {
    border-color: white;
    background: white;
    color: var(--color-primary-strong);
  }

  .button-light:hover,
  .button-light:focus-visible {
    background: #eefbff;
    color: var(--color-primary-strong);
  }

  .button-full {
    width: 100%;
  }

  .hero-note {
    margin-top: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .status-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: #45a66b;
    box-shadow: 0 0 0 5px rgba(69, 166, 107, 0.12);
  }

  .hero-visual {
    position: relative;
    min-height: 31rem;
    border-radius: 2rem;
    overflow: hidden;
    background: linear-gradient(180deg, #bce8f5 0%, #e5f4df 54%, #d6e8ca 100%);
    box-shadow: 0 30px 70px rgba(24, 67, 86, 0.16);
  }

  .sun {
    position: absolute;
    top: 3rem;
    right: 4rem;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: #ffe7a3;
    box-shadow: 0 0 0 14px rgba(255, 231, 163, 0.24);
  }

  .tree {
    position: absolute;
    bottom: 10rem;
    width: 0;
    height: 0;
    border-left: 2.6rem solid transparent;
    border-right: 2.6rem solid transparent;
    border-bottom: 7rem solid #4f8b64;
    filter: drop-shadow(0 10px 8px rgba(49, 93, 62, 0.15));
  }

  .tree::after {
    content: '';
    position: absolute;
    top: 5.7rem;
    left: -0.3rem;
    width: 0.6rem;
    height: 2.6rem;
    background: #76624a;
  }

  .tree-one {
    left: 2.5rem;
  }

  .tree-two {
    right: 1.8rem;
    transform: scale(0.78);
  }

  .pool-shell {
    position: absolute;
    left: 9%;
    right: 9%;
    bottom: 4rem;
    height: 13.5rem;
    padding: 1rem;
    border-radius: 45% 45% 36% 36% / 34% 34% 54% 54%;
    background: #f8f2df;
    transform: perspective(700px) rotateX(58deg);
    box-shadow: 0 24px 30px rgba(70, 97, 73, 0.16);
  }

  .pool-water {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
    background: linear-gradient(150deg, #2eb7d9, #0f86b6 65%, #136b9b);
  }

  .pool-water span {
    position: absolute;
    left: -10%;
    width: 120%;
    height: 0.35rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.38);
    transform: rotate(-4deg);
  }

  .pool-water span:nth-child(1) { top: 30%; }
  .pool-water span:nth-child(2) { top: 52%; left: -3%; }
  .pool-water span:nth-child(3) { top: 70%; left: -14%; }

  .visual-card {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.95rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 15px 30px rgba(23, 54, 67, 0.14);
    backdrop-filter: blur(10px);
  }

  .visual-card-icon {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #dff5ea;
    color: #287a4d;
    font-weight: 900;
  }

  .visual-card strong,
  .visual-card small {
    display: block;
  }

  .visual-card small {
    color: var(--color-muted);
  }

  .trust-strip {
    padding: 2.2rem 0;
    border-top: 1px solid rgba(216, 228, 236, 0.85);
    border-bottom: 1px solid rgba(216, 228, 236, 0.85);
    background: white;
  }

  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .trust-item {
    display: flex;
    gap: 0.75rem;
  }

  .trust-item h2 {
    margin-bottom: 0.25rem;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .trust-item p {
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .trust-icon {
    flex: 0 0 auto;
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #e2f5fb;
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  .scope-section {
    background: white;
  }

  .scope-card,
  .pricing-card {
    padding: clamp(1.5rem, 4vw, 2.4rem);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: #f9fcfe;
    box-shadow: var(--shadow-sm);
  }

  .scope-label,
  .pricing-kicker {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .scope-card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .scope-card li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    font-weight: 700;
  }

  .scope-card li > span:first-child {
    color: #2e8a56;
  }

  .scope-note {
    margin: 1.5rem 0 0;
    padding-top: 1.3rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .process-section {
    background: #eef8fc;
  }

  .section-heading {
    max-width: 47rem;
    margin-bottom: 2.4rem;
  }

  .centered {
    margin-inline: auto;
    text-align: center;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .process-card {
    min-height: 15rem;
    padding: 1.5rem;
    border: 1px solid rgba(198, 221, 231, 0.9);
    border-radius: 1.3rem;
    background: white;
    box-shadow: 0 12px 30px rgba(24, 67, 86, 0.06);
  }

  .step-number {
    display: block;
    margin-bottom: 2.5rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.13em;
  }

  .process-card p,
  .faq-heading > p:last-child,
  .pricing-card p,
  .area-card p,
  .site-footer p {
    color: var(--color-muted);
  }

  .pricing-section {
    background: white;
  }

  .pricing-card {
    background: linear-gradient(160deg, #0e6b98, #0b5a80);
    color: white;
    border: none;
  }

  .pricing-card .pricing-kicker,
  .pricing-card p {
    color: #c8ebf5;
  }

  .pricing-card strong {
    display: block;
    margin-bottom: 0.7rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .text-link {
    color: var(--color-primary-strong);
    font-weight: 850;
    text-decoration: none;
  }

  .area-section {
    padding-top: 0;
    background: white;
  }

  .area-card {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: 2rem;
    padding: clamp(1.5rem, 5vw, 3.2rem);
    border-radius: 1.5rem;
    background: #f0f8f3;
    border: 1px solid #d7eadc;
  }

  .area-card h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }

  .area-badge {
    justify-self: end;
    width: min(15rem, 100%);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-content: center;
    text-align: center;
    background: white;
    box-shadow: var(--shadow-sm);
  }

  .area-badge span,
  .area-badge small {
    display: block;
  }

  .area-badge span {
    color: var(--color-primary-strong);
    font-size: 3rem;
    font-weight: 950;
    letter-spacing: -0.06em;
  }

  .area-badge small {
    max-width: 9rem;
    color: var(--color-muted);
  }

  .quote-section {
    background: #0a5678;
    color: white;
  }

  .quote-shell {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .quote-copy > p:not(.eyebrow) {
    max-width: 35rem;
    color: #cde8f1;
  }

  .quote-preview {
    padding: 1.2rem;
    display: grid;
    gap: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 1.4rem;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
  }

  .preview-row {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.08);
  }

  .preview-row > span {
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: white;
    color: var(--color-primary-strong);
    font-weight: 900;
  }

  .preview-row strong,
  .preview-row small {
    display: block;
  }

  .preview-row small {
    color: #cde8f1;
  }

  .faq-section {
    background: #f8fbfd;
  }

  .faq-layout {
    align-items: start;
  }

  .faq-list {
    border-top: 1px solid var(--color-border);
  }

  details {
    border-bottom: 1px solid var(--color-border);
  }

  summary {
    cursor: pointer;
    padding: 1.2rem 2rem 1.2rem 0;
    font-weight: 850;
    list-style: none;
    position: relative;
  }

  summary::-webkit-details-marker {
